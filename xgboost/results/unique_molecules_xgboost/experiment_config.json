{
  "input_file": "unique_molecules_Tc_Pc_omega.csv",
  "targets": [
    "Tc (K)",
    "Pc (bar)",
    "omega (-)"
  ],
  "xgb_params": {
    "n_estimators": 3000,
    "learning_rate": 0.03,
    "max_depth": 7,
    "subsample": 0.8,
    "colsample_bytree": 0.7,
    "min_child_weight": 3,
    "reg_alpha": 0.1,
    "reg_lambda": 1.0,
    "random_state": 42,
    "n_jobs": -1,
    "tree_method": "hist",
    "early_stopping_rounds": 150
  },
  "seed": 42,
  "cv_folds": 5,
  "feature_dim": 2265,
  "organic_element_filter": [
    "Br",
    "C",
    "Cl",
    "F",
    "H",
    "I",
    "N",
    "O",
    "P",
    "S"
  ]
}